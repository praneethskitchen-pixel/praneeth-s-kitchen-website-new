<svg width="600" height="600" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Metallic Gold Gradients -->
    <linearGradient id="goldBright" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#F9EAA2" />
      <stop offset="35%" stopColor="#E5C158" />
      <stop offset="70%" stopColor="#D4A034" />
      <stop offset="100%" stopColor="#9E7820" />
    </linearGradient>

    <linearGradient id="goldDeep" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#EAD27B" />
      <stop offset="50%" stopColor="#C89D2B" />
      <stop offset="100%" stopColor="#8A6711" />
    </linearGradient>

    <!-- Drop Shadow Filter for 3D Embossed Effect -->
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="5" stdDeviation="4" floodColor="#000000" floodOpacity="0.25" />
    </filter>

    <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="1" dy="3" stdDeviation="3" floodColor="#C89D2B" floodOpacity="0.3" />
    </filter>
  </defs>

  <!-- Cream Background Circle for Standalone Visual Balance -->
  <rect width="600" height="600" rx="32" fill="#F4ECE1" />

  <!-- Outer Sweeping Golden Arc (Top Right) -->
  <path
    d="M 260 75 C 380 75, 470 165, 470 280 C 470 315, 460 350, 440 380"
    fill="none"
    stroke="url(#goldBright)"
    strokeWidth="4"
    strokeLinecap="round"
    filter="url(#goldGlow)"
  />

  <path
    d="M 170 160 C 145 200, 140 250, 150 290"
    fill="none"
    stroke="url(#goldBright)"
    strokeWidth="2.5"
    strokeLinecap="round"
    opacity="0.8"
  />

  <!-- CHEF HAT ON TOP OF P -->
  <g id="chef-hat" filter="url(#softShadow)">
    <!-- White Puff Topping -->
    <path
      d="M 205,170 C 180,120 230,85 258,112 C 275,85 310,85 327,112 C 355,85 405,120 380,170 Z"
      fill="#FFFFFF"
      stroke="#1A1817"
      strokeWidth="5"
      strokeLinejoin="round"
    />
    <!-- Hat Brim Band -->
    <rect
      x="200"
      y="162"
      width="180"
      height="22"
      rx="5"
      fill="#1A1817"
      stroke="url(#goldBright)"
      strokeWidth="2"
    />
  </g>

  <!-- CENTRAL MONOGRAM: BLACK 'P' AND GOLD 'K' -->
  <g id="monogram" filter="url(#softShadow)">
    <!-- Black Serif Letter P -->
    <!-- Main Vertical Stem of P -->
    <path
      d="M 210,170 L 290,170 M 250,170 L 250,380 M 210,380 L 290,380"
      stroke="#1A1817"
      strokeWidth="28"
      strokeLinecap="square"
      strokeLinejoin="miter"
    />
    <!-- Loop of Letter P -->
    <path
      d="M 250,170 L 330,170 C 380,170 395,200 395,235 C 395,270 380,295 330,295 L 250,295"
      fill="none"
      stroke="#1A1817"
      strokeWidth="28"
      strokeLinecap="square"
      strokeLinejoin="round"
    />

    <!-- Metallic Gold Letter K -->
    <!-- Diagonal Arms of K -->
    <path
      d="M 315,265 L 435,170 M 390,170 L 445,170"
      stroke="url(#goldBright)"
      strokeWidth="26"
      strokeLinecap="square"
    />
    <path
      d="M 315,255 L 445,380 M 395,380 L 455,380"
      stroke="url(#goldBright)"
      strokeWidth="26"
      strokeLinecap="square"
    />
  </g>

  <!-- ELEGANT BLACK CURVED SPOON (Crossing horizontally) -->
  <g id="spoon" filter="url(#softShadow)">
    <!-- Spoon Handle & Bowl Path -->
    <path
      d="M 180,285 C 240,285 280,265 370,225 C 400,212 430,200 450,195 C 470,190 480,205 465,220 C 445,238 410,250 370,258 C 280,275 230,295 180,285 Z"
      fill="#1A1817"
    />
    <!-- Spoon Bowl Specular Highlight -->
    <ellipse cx="445" cy="210" rx="18" ry="8" transform="rotate(-20 445 210)" fill="url(#goldBright)" opacity="0.6" />
  </g>

  <!-- LEFT GOLDEN LAUREL LEAVES -->
  <g id="laurel-branch" filter="url(#goldGlow)">
    <path
      d="M 185,355 C 165,330 155,290 160,250"
      fill="none"
      stroke="url(#goldBright)"
      strokeWidth="3.5"
      strokeLinecap="round"
    />
    <!-- Leaves -->
    <path d="M 155,255 C 140,240 135,260 150,270 C 160,270 162,258 155,255 Z" fill="url(#goldBright)" />
    <path d="M 148,285 C 130,278 128,298 145,302 C 155,300 156,288 148,285 Z" fill="url(#goldBright)" />
    <path d="M 158,315 C 140,312 142,330 158,332 C 166,328 166,318 158,315 Z" fill="url(#goldBright)" />
    <path d="M 172,342 C 158,345 162,360 176,358 C 182,352 180,344 172,342 Z" fill="url(#goldBright)" />
  </g>

  <!-- RIGHT CIRCUIT / TECH BRANCH LINES -->
  <g id="tech-lines" stroke="url(#goldBright)" strokeWidth="2.5" fill="none" opacity="0.85">
    <path d="M 445,320 L 485,320 L 510,295" />
    <circle cx="510" cy="295" r="3.5" fill="url(#goldBright)" stroke="none" />

    <path d="M 455,340 L 475,340 L 495,320 L 515,320" />
    <circle cx="515" cy="320" r="3.5" fill="url(#goldBright)" stroke="none" />

    <path d="M 435,355 L 465,355 L 480,370 L 500,370" />
    <circle cx="500" cy="370" r="3.5" fill="url(#goldBright)" stroke="none" />

    <path d="M 425,370 L 445,370 L 460,390 L 485,390" />
    <circle cx="485" cy="390" r="3.5" fill="url(#goldBright)" stroke="none" />
  </g>

  <!-- BRAND NAME TYPOGRAPHY -->
  <g id="brand-text">
    <!-- PRANEETH'S -->
    <text
      x="300"
      y="445"
      textAnchor="middle"
      fill="#1A1817"
      fontSize="36"
      fontWeight="900"
      fontFamily="Georgia, 'Times New Roman', serif"
      letterSpacing="6"
    >
      PRANEETH'S
    </text>

    <!-- K I T C H E N WITH SIDE LINES -->
    <line x1="120" y1="472" x2="210" y2="472" stroke="url(#goldBright)" strokeWidth="2" />
    <text
      x="300"
      y="478"
      textAnchor="middle"
      fill="url(#goldDeep)"
      fontSize="20"
      fontWeight="800"
      fontFamily="'Cinzel', Georgia, serif"
      letterSpacing="10"
    >
      KITCHEN
    </text>
    <line x1="390" y1="472" x2="480" y2="472" stroke="url(#goldBright)" strokeWidth="2" />

    <!-- BOTTOM DECORATIVE CROSSED FORK & SPOON -->
    <g transform="translate(300, 510)" stroke="#1A1817" strokeWidth="2" strokeLinecap="round">
      <line x1="-160" y1="0" x2="-25" y2="0" stroke="#C59B27" strokeWidth="1" />
      <circle cx="-20" cy="0" r="2.5" fill="#1A1817" stroke="none" />

      <!-- Crossed Fork & Spoon -->
      <path d="M -8,-8 L 8,8 M -8,8 L 8,-8" stroke="#1A1817" strokeWidth="2.5" />

      <circle cx="20" cy="0" r="2.5" fill="#1A1817" stroke="none" />
      <line x1="25" y1="0" x2="160" y2="0" stroke="#C59B27" strokeWidth="1" />
    </g>
  </g>
</svg>
